CC      ?= gcc
CFLAGS  ?= -std=c11 -Wall -Wextra -O2 -g
LDFLAGS ?= -lpthread
IMPL    ?= reference

ifeq ($(IMPL),reference)
  IMPL_DIR := impl/reference
  IMPL_SRC := $(IMPL_DIR)/mythread.c
  IMPL_LIB :=
else ifeq ($(IMPL),custom)
  # Copy-paste friendly: drop your library into impl/custom/ and build.
  # Sources, static archives and include dirs are discovered automatically,
  # any nesting inside impl/custom/ works.
  IMPL_DIR := impl/custom
  CUSTOM_SRCS  := $(shell find $(IMPL_DIR) -type f -name '*.c' 2>/dev/null)
  CUSTOM_HDRS  := $(shell find $(IMPL_DIR) -type f -name '*.h' 2>/dev/null)
  CUSTOM_LIBS  := $(shell find $(IMPL_DIR) -type f -name '*.a' 2>/dev/null)

  IMPL_SRC := $(CUSTOM_SRCS)
  IMPL_LIB := $(CUSTOM_LIBS)
  IMPL_INC := $(sort $(dir $(CUSTOM_HDRS)))

  # The public contract (include/mythread.h) does #include "mythread_types.h".
  # Resolution order ("weak definitions" for types):
  #   1. impl/custom/mythread_types.h           — yours, used verbatim;
  #   2. any header under impl/custom/ mentioning mythread_t — wired up
  #      via an auto-generated redirect shim in build/;
  #   3. include/mythread_types_default.h       — framework fallback, so a
  #      skeleton compiles before types are written.
  ifeq ($(wildcard $(IMPL_DIR)/mythread_types.h),)
    ifneq ($(strip $(CUSTOM_HDRS)),)
      TYPES_CAND     := $(shell grep -lw mythread_t $(CUSTOM_HDRS) 2>/dev/null)
      TYPES_DEFINERS := $(shell grep -lw typedef $(TYPES_CAND) 2>/dev/null)
      TYPES_HDR := $(firstword $(if $(TYPES_DEFINERS),$(TYPES_DEFINERS),$(TYPES_CAND)))
    endif
    ifeq ($(strip $(TYPES_HDR)),)
      TYPES_HDR := include/mythread_types_default.h
      USING_DEFAULT_TYPES := 1
    endif
    NEEDS_SHIM := 1
  else
    TYPES_HDR := $(IMPL_DIR)/mythread_types.h
  endif
else
  $(error Unknown IMPL=$(IMPL))
endif

# Mandatory flags use 'override': a CFLAGS=... given on the command line
# (e.g. by the sanitize targets) then adds to them instead of silently
# dropping the include paths and the contract header.
override CFLAGS += -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE
# 'include' comes first: the public API contract must always beat any
# implementation-internal header of the same name.
override CFLAGS += -Iinclude -I$(IMPL_DIR) -Iframework -Itests

# Signature check: force the public contract into every translation unit
# *before* any implementation header. C links by name only, so a function
# defined with a wrong signature would otherwise link silently and be UB
# at runtime; with the contract declaration visible first, a mismatching
# definition fails to compile with "conflicting types for 'mythread_...'".
override CFLAGS += -include include/mythread.h

ifeq ($(strip $(STRICT)),1)
  override CFLAGS += -DMYTHREAD_STRICT_ERRORS
endif

ifneq ($(strip $(IMPL_INC)),)
  override CFLAGS += $(addprefix -I,$(filter $(IMPL_DIR)/%,$(IMPL_INC)))
endif

ifeq ($(strip $(NEEDS_SHIM)),1)
  override CFLAGS += -Ibuild
  # Regenerated every build, so renaming your headers needs no make clean.
  mythread_tests: build/mythread_types.h
endif

SRC := \
    main.c \
    framework/runner.c \
    tests/test_create.c \
    tests/test_join.c \
    tests/test_detach.c \
    tests/test_exit.c \
    tests/test_stress.c \
    tests/test_lifecycle.c \
    tests/test_race.c \
    tests/test_resource.c \
    tests/test_errors.c \
    $(IMPL_SRC)

mythread_tests: $(SRC)
ifneq ($(strip $(USING_DEFAULT_TYPES)),)
	@echo "NOTE: no mythread_t definition found under $(IMPL_DIR)/ — using" \
	      "framework fallback (include/mythread_types_default.h)." >&2
	@echo "      Provide your own types header if your handle is not an unsigned long." >&2
endif
	$(CC) $(CFLAGS) $(filter %.c,$^) $(IMPL_LIB) -o $@ $(LDFLAGS)

build/mythread_types.h: FORCE
	@mkdir -p $(@D)
	@printf '%s\n' \
	    '/* Auto-generated by the Makefile — do not edit. */' \
	    '/* Redirects the public contract to the implementation types: $(TYPES_HDR) */' \
	    '#ifndef MYTHREAD_TYPES_AUTO_SHIM' \
	    '#define MYTHREAD_TYPES_AUTO_SHIM' \
	    '#include "../$(TYPES_HDR)"' \
	    '#endif' > $@

check-reference: mythread_tests
	./mythread_tests

check-custom:
	$(MAKE) clean
	$(MAKE) IMPL=custom mythread_tests
	./mythread_tests

# Same suite built with -DMYTHREAD_STRICT_ERRORS: invalid, stale and
# detached handles must be rejected with an explicit error code. Use it
# to grade implementations that validate their handles; the pthread
# reference does not, so some tests are expected to fail there.
check-strict:
	$(MAKE) clean
	$(MAKE) STRICT=1 mythread_tests
	./mythread_tests

# [S11] Same suite under sanitizers. TSan is the interesting one for a
# thread library: it proves the tests synchronize through real atomics
# (no data races in the tests themselves) and surfaces races inside the
# student implementation. ASan+UBSan catch memory errors in both.
sanitize:
	$(MAKE) clean
	$(MAKE) mythread_tests \
	    CFLAGS="-std=c11 -Wall -Wextra -O1 -g -fsanitize=thread" \
	    LDFLAGS="-fsanitize=thread -lpthread"
	./mythread_tests

sanitize-mem:
	$(MAKE) clean
	$(MAKE) mythread_tests \
	    CFLAGS="-std=c11 -Wall -Wextra -O1 -g -fsanitize=address,undefined" \
	    LDFLAGS="-fsanitize=address,undefined -lpthread"
	./mythread_tests

# Valgrind memcheck over the suite the normal way: slow but thorough.
# The per-test runner timeout still applies — that is [S12] in action.
valgrind: mythread_tests
	valgrind --error-exitcode=99 ./mythread_tests

clean:
	rm -rf build
	rm -f mythread_tests

.PHONY: check-reference check-custom check-strict sanitize sanitize-mem valgrind clean FORCE
